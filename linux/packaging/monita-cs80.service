# Monita-CS80 副屏上位机：systemd --user 单元示例
#   cp linux/packaging/monita-cs80.service ~/.config/systemd/user/
#   按你的 clone 位置改 ExecStart，然后：
#   systemctl --user daemon-reload && systemctl --user enable --now monita-cs80
#   journalctl --user -u monita-cs80 -f
# 挂 default.target 而不是 graphical-session.target：后者在 sway / i3 下不会被启动，服务就永远起不来。
# MPRIS（会话总线）和 PipeWire 都在用户管理器里，不依赖图形会话；设备不在时进程自己每 2 s 重连、不退出。
[Unit]
Description=Monita-CS80 副屏上位机

[Service]
ExecStart=%h/.local/share/monita-cs80/linux/monita-cs80-linux --device usb
Restart=on-failure
RestartSec=3
# 退出码 2 = 永久错误（缺中文字体 / 参数不对），重启也没用：别每 3 s 刷一遍日志
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
